{
  "name": "economic-voting-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Estimates how tax and benefit policy changes would affect your household, in dollars, from a rules engine encoding actual statute.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "data": "python3 pipeline/generate_grid.py --out src/data/grid.json",
    "data:votes": "python3 pipeline/ingest_votes.py --out src/data/officeholders.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
